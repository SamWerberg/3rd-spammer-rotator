local Players = game:GetService("Players")
local TextChatService = game:GetService("TextChatService")
local ChatService = game:GetService("Chat")
local UserInputService = game:GetService("UserInputService")

local Player = Players.LocalPlayer
local Channel = TextChatService.TextChannels:WaitForChild("RBXGeneral")

local spamming = false
local spamDelay = 1

local gui = Instance.new("ScreenGui")
gui.Name = "SpamGUI"
gui.ResetOnSpawn = false
gui.Parent = Player:WaitForChild("PlayerGui")

local frame = Instance.new("Frame")
frame.Parent = gui
frame.Size = UDim2.new(0, 350, 0, 420)
frame.Position = UDim2.new(0.35,0,0.2,0)
frame.BackgroundColor3 = Color3.fromRGB(25,25,25)
frame.BorderSizePixel = 0
frame.Active = true
frame.Draggable = true
Instance.new("UICorner", frame)

local title = Instance.new("TextLabel")
title.Parent = frame
title.Size = UDim2.new(1,0,0,35)
title.BackgroundTransparency = 1
title.Text = "SPAM GUI"
title.TextScaled = true
title.Font = Enum.Font.GothamBold
title.TextColor3 = Color3.new(1,1,1)

local scroll = Instance.new("ScrollingFrame")
scroll.Parent = frame
scroll.Size = UDim2.new(0.9,0,0.45,0)
scroll.Position = UDim2.new(0.05,0,0.1,0)
scroll.CanvasSize = UDim2.new(0,0,0,0)
scroll.BackgroundColor3 = Color3.fromRGB(35,35,35)
scroll.BorderSizePixel = 0
scroll.ScrollBarThickness = 5
Instance.new("UICorner", scroll)

local layout = Instance.new("UIListLayout")
layout.Parent = scroll
layout.Padding = UDim.new(0,5)

local textboxes = {}

local function updateCanvas()
	scroll.CanvasSize = UDim2.new(
		0,
		0,
		0,
		layout.AbsoluteContentSize.Y + 10
	)
end

local function addBox(defaultText)
	local box = Instance.new("TextBox")
	box.Parent = scroll
	box.Size = UDim2.new(1,-10,0,40)
	box.BackgroundColor3 = Color3.fromRGB(45,45,45)
	box.TextColor3 = Color3.new(1,1,1)
	box.PlaceholderText = "Message"
	box.Text = defaultText or ""
	box.TextScaled = true
	box.ClearTextOnFocus = false
	Instance.new("UICorner", box)

	table.insert(textboxes, box)

	updateCanvas()
end

addBox()

local addBtn = Instance.new("TextButton")
addBtn.Parent = frame
addBtn.Size = UDim2.new(0.18,0,0.1,0)
addBtn.Position = UDim2.new(0.05,0,0.58,0)
addBtn.Text = "+"
addBtn.TextScaled = true
addBtn.BackgroundColor3 = Color3.fromRGB(0,120,255)
addBtn.TextColor3 = Color3.new(1,1,1)
Instance.new("UICorner", addBtn)

local removeBtn = Instance.new("TextButton")
removeBtn.Parent = frame
removeBtn.Size = UDim2.new(0.18,0,0.1,0)
removeBtn.Position = UDim2.new(0.25,0,0.58,0)
removeBtn.Text = "-"
removeBtn.TextScaled = true
removeBtn.BackgroundColor3 = Color3.fromRGB(170,0,0)
removeBtn.TextColor3 = Color3.new(1,1,1)
Instance.new("UICorner", removeBtn)

addBtn.MouseButton1Click:Connect(function()
	addBox()
end)

removeBtn.MouseButton1Click:Connect(function()
	if #textboxes > 1 then
		local lastBox = textboxes[#textboxes]

		if lastBox then
			lastBox:Destroy()
		end

		table.remove(textboxes, #textboxes)

		updateCanvas()
	end
end)

local speedBox = Instance.new("TextBox")
speedBox.Parent = frame
speedBox.Size = UDim2.new(0.5,0,0.1,0)
speedBox.Position = UDim2.new(0.45,0,0.58,0)
speedBox.PlaceholderText = "Spam Delay"
speedBox.Text = "1"
speedBox.TextScaled = true
speedBox.BackgroundColor3 = Color3.fromRGB(40,40,40)
speedBox.TextColor3 = Color3.new(1,1,1)
speedBox.ClearTextOnFocus = false
Instance.new("UICorner", speedBox)

local startBtn = Instance.new("TextButton")
startBtn.Parent = frame
startBtn.Size = UDim2.new(0.42,0,0.12,0)
startBtn.Position = UDim2.new(0.05,0,0.75,0)
startBtn.Text = "START"
startBtn.TextScaled = true
startBtn.BackgroundColor3 = Color3.fromRGB(0,170,0)
startBtn.TextColor3 = Color3.new(1,1,1)
Instance.new("UICorner", startBtn)

local stopBtn = Instance.new("TextButton")
stopBtn.Parent = frame
stopBtn.Size = UDim2.new(0.42,0,0.12,0)
stopBtn.Position = UDim2.new(0.53,0,0.75,0)
stopBtn.Text = "STOP"
stopBtn.TextScaled = true
stopBtn.BackgroundColor3 = Color3.fromRGB(170,0,0)
stopBtn.TextColor3 = Color3.new(1,1,1)
Instance.new("UICorner", stopBtn)

local function isTagged(text)
	local success, filtered = pcall(function()
		return ChatService:FilterStringForBroadcast(
			text,
			Player,
			Player.UserId
		)
	end)

	if not success or not filtered then
		return true
	end

	return filtered ~= text
end

startBtn.MouseButton1Click:Connect(function()
	if spamming then return end

	local delayValue = tonumber(speedBox.Text)
	if delayValue and delayValue > 0 then
		spamDelay = delayValue
	end

	spamming = true

	task.spawn(function()
		local index = 1

		while spamming do
			if #textboxes > 0 then
				local currentBox = textboxes[index]

				if currentBox and currentBox.Text ~= "" then
					local msg = currentBox.Text

					if not isTagged(msg) then
						pcall(function()
							Channel:SendAsync(msg)
						end)
					end
				end

				index += 1

				if index > #textboxes then
					index = 1
				end
			end

			task.wait(spamDelay)
		end
	end)
end)

stopBtn.MouseButton1Click:Connect(function()
	spamming = false
end)
